# Database
DATABASE_URL=postgresql+asyncpg://user:pass@host/db?ssl=require

# JWT
JWT_SECRET=replace-with-64-char-hex-string-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# Telegram
BOT_TOKEN=replace-with-botfather-token
ADMIN_TELEGRAM_ID=123456789

# CORS
FRONTEND_URL=https://budgetapp-production-a39a.up.railway.app

# Host header allowlist (optional). Comma-separated. Leave unset to allow any
# Host header (current default in prod). Once you've confirmed what Host
# header your platform's healthcheck actually sends, set this to your public
# API domain(s) to reject spoofed-Host requests, e.g.:
# ALLOWED_HOSTS=budget-app-production-9ed5.up.railway.app

# Sentry
SENTRY_DSN=https://replace@sentry.io/project-id
